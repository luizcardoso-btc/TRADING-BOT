# ════════════════════════════════════════════════════════
# ACS Trading Bot — Configuração de Ambiente
# Copie para .env e preencha com suas chaves reais
# ════════════════════════════════════════════════════════

PORT=3002
ADMIN_KEY=acs@Admin2026!

# ── Bybit ────────────────────────────────────────────────
BYBIT_API_KEY=sua_api_key_aqui
BYBIT_API_SECRET=seu_api_secret_aqui
BYBIT_TESTNET=false        # true para testar sem dinheiro real

# ── Binance ──────────────────────────────────────────────
BINANCE_API_KEY=sua_api_key_aqui
BINANCE_API_SECRET=seu_api_secret_aqui

# ── Novadex (Hyperliquid DEX) ────────────────────────────
NOVADEX_PRIVATE_KEY=0xsua_private_key_da_carteira
NOVADEX_WALLET=0xendereco_da_sua_carteira
NOVADEX_RPC=https://rpc.hyperliquid.xyz/evm

# ── Execução automática ───────────────────────────────────
# ATENÇÃO: coloque true apenas quando estiver 100% confiante
SIG_AUTO_EXECUTE=false     # true = executa sinais automaticamente
ARB_AUTO_EXECUTE=false     # true = executa arbitragem automaticamente
AUTO_SCAN_START=true       # true = inicia scan ao subir o bot

# ── Parâmetros de risco ───────────────────────────────────
DEFAULT_LEVERAGE=5         # alavancagem padrão
DEFAULT_EXCHANGE=bybit     # exchange padrão para sinais
MAX_DAILY_LOSS=5           # % máximo de perda diária da banca
MAX_POSITIONS=5            # número máximo de posições simultâneas
MAX_POS_USD=500            # tamanho máximo por posição em USD
ARB_MIN_PROFIT=0.15        # % mínimo de lucro para alertar arb
ARB_MAX_POS=500            # USD máximo por operação de arb
